            },
            {
              "val": "US",
              "as": "vendor_country"
            },
            {
              "func": "ROUND",
              "args": [
                {
                  "xpr": [
                    {
                      "val": 1
                    },
                    "-",
                    {
                      "func": "SUM",
                      "args": [
                        {
                          "xpr": [
                            "case",
                            "when",
                            {
                              "func": "TO_DATE",
                              "args": [
                                {
