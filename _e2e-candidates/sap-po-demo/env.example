# Copy this file to .env and fill in real values. NEVER commit .env.

# --- SAP S/4HANA (the lab endpoint and communication user) ---
SAP_BASE_URL=https://your-s4-host:44300
SAP_USER=your_communication_user
SAP_PASSWORD=your_password
VERIFY_SSL=false
DIRECT_PO_TYPES=NB
SALES_ORG=1710
DIST_CHANNEL=10
DIVISION=00
SO_TYPE=OR

# --- Google Gemini (AI Studio API key; put on billing for demo day) ---
GOOGLE_API_KEY=your_ai_studio_key

# --- SAP Build Process Automation (service key: standard plan) ---
SBPA_CLIENT_ID=sb-...!bNNNNNN|xsuaa!bNNNNNN
SBPA_CLIENT_SECRET=your_client_secret
SBPA_TOKEN_URL=https://your-subaccount.authentication.eu10.hana.ondemand.com/oauth/token
SBPA_API_URL=https://spa-api-gateway-bpi-eu-prod.cfapps.eu10.hana.ondemand.com
SBPA_DEFINITION_ID=eu10.your-subaccount.projectid.processid

# --- Lab mailbox (Gmail with 2FA + app password) ---
MAIL_USER=lab-mailbox@gmail.com
MAIL_APP_PASSWORD=your16charapppassword
IMAP_HOST=imap.gmail.com
SMTP_HOST=smtp.gmail.com
