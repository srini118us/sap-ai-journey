{
  "name": "pdcap",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/sqlite": "^2.4",
    "@sap-cloud-sdk/connectivity": "^4.7.0",
    "@sap-cloud-sdk/http-client": "^4.7.0",
    "@sap-cloud-sdk/util": "^4.7.0",
    "@sap/cds": "^9",
    "@sap/low-code-event-handler": "^1.2.5",
    "@sap/xsenv": ">=3.3.2 <3.3.3",
    "@sap/xssec": "^4",
    "passport": "^0.7.0"
  },
  "devDependencies": {
    "@sap/cds-dk": "^9",
    "@sap/dev-cap-tools": "^1.31.0"
  },
  "scripts": {
    "start": "cds-serve",
    "start-local": "npm run generate-entry-point && npm run cds-watch",
    "generate-entry-point": "dev-cap-tools gen-entrypoint",
    "cds-watch": "cds watch --open"
  },
  "private": true,
  "cds": {
    "requires": {
      "db": {
        "[development]": {
          "kind": "sqlite"
        },
        "[production]": {
          "kind": "sqlite",
          "credentials": { "database": "srv/db.sqlite" }
        }
      },
      "auth": {
        "[development]": { "kind": "dummy" },
        "[production]": { "kind": "xsuaa" }
      },
      "destinations": true
    }
  },
  "lcap": true
}