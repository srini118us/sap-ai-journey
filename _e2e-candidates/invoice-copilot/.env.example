# invoice-copilot — SAP AI Core / GenAI Hub credentials
# Copy to .env and fill in real values from the AI Core service key JSON
# (BTP Cockpit > Instances and Subscriptions > ai-core > Service Keys > View Credentials).
# .env is gitignored. Never commit it, never print these values.

# Service key field: url
AICORE_AUTH_URL=https://<subaccount>.authentication.<region>.hana.ondemand.com

# Service key field: serviceurls.AI_API_URL
AICORE_BASE_URL=https://api.ai.prod.<region>.aws.ml.hana.ondemand.com

# Service key field: clientid
AICORE_CLIENT_ID=sb-<uuid>!b<num>|aicore!b<num>

# Service key field: clientsecret
AICORE_CLIENT_SECRET=<your-client-secret>

# AI Core resource group holding the GenAI Hub deployment
AICORE_RESOURCE_GROUP=default

# GenAI Hub model used for field extraction
MODEL_NAME=gpt-4o-mini

# AI Core deployment serving SAP RPT-1.5, used by the score node for risk
# scoring. Find it in AI Launchpad (Deployments) or via the AI Core API: it is
# the deployment whose configuration binds modelName=sap-rpt-1.5. Not a secret,
# but environment-specific.
RPT_DEPLOYMENT_ID=d0000000000000

# --- S/4HANA purchase-order lookup ---
# Used by src/s4hana.py only, for the validate node's PO check. Reads
# API_PURCHASEORDER_PROCESS_SRV over OData with basic auth.

# Host serving the OData service, scheme and port included, no trailing slash.
# Environment-specific and a production system identifier, so it is never
# hardcoded in source.
S4_BASE_URL=https://<host>.<domain>:<port>

# Communication user authorized for API_PURCHASEORDER_PROCESS_SRV (read).
S4_USER=<your-s4-user>

# THIS IS A SECRET. It is sent as basic auth and must never be printed, logged,
# put in a URL, or echoed in an error message.
S4_PASSWORD=<your-s4-password>

# --- Cross-cloud second opinion (Google Cloud Run + Gemini) ---
# Used by src/vertex_secondopinion.py only. Not part of the SAP AI Core path:
# the graph's extract node still goes through GenAI Hub.

# The private Cloud Run endpoint serving the Gemini extraction agent. This is
# also the audience the identity token is signed for, so the two can never
# drift apart. Environment-specific (it carries the GCP project number), but
# not a secret.
VERTEX_EXTRACT_URL=https://vertex-extract-<project-number>.<region>.run.app/extract

# The service account key used to mint identity tokens for that endpoint,
# base64-encoded. THIS IS A SECRET -- the decoded JSON contains a private key.
# The service account needs roles/run.invoker on the Cloud Run service.
#   PowerShell:
#     [Convert]::ToBase64String([IO.File]::ReadAllBytes("key.json"))
GCP_SA_KEY_B64=<base64-of-your-service-account-key-json>
