# AI Core Configuration
# Copy this file to .env and fill in your actual credentials from the service key JSON
# These are the environment variable names expected by the SAP AI Core SDK

MODEL_NAME=gpt-4o-mini
AICORE_AUTH_URL=https://oauth.authentication.example.com
AICORE_BASE_URL=https://api.ai.core.example.com
AICORE_API_KEY=your_secret_key_here
AICORE_RESOURCE_GROUP=default
AI_CORE_MODEL_ID=gpt-4o
