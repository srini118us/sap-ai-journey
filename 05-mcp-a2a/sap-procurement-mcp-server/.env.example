# SAP HANA Cloud Connection
HANA_ADDRESS=your-hana-host.hanacloud.ondemand.com
HANA_PORT=443
HANA_USER=DBADMIN
HANA_PASSWORD=your-password

# SAP GenAI Hub - Embedding
GENAI_HUB_BASE_URL=https://api.ai.prod.us-east-1.aws.ml.hana.ondemand.com
GENAI_HUB_AUTH_URL=https://your-tenant.authentication.us10.hana.ondemand.com/oauth/token
GENAI_HUB_CLIENT_ID=your-client-id
GENAI_HUB_CLIENT_SECRET=your-client-secret
GENAI_HUB_RESOURCE_GROUP=ai-launchpad

# Deployment IDs (from Lab 52)
EMBEDDING_DEPLOYMENT_ID=da94363cd9046ce4
LLM_DEPLOYMENT_ID=d0630de3469c64eb

# MCP Server Config
MCP_SERVER_NAME=procurement-server
MCP_HOST=0.0.0.0
MCP_PORT=8080
FASTMCP_STATELESS_HTTP=true

# Schema
HANA_SCHEMA=PROC_AI
